# Configuracion del proyecto. Copiar a .env y ajustar si hace falta:
#     cp .env.example .env
# Todos los valores de este archivo son los usados en el trabajo. No contiene
# secretos: si falta el .env, config/params.py usa estos mismos valores por
# defecto y lee las variables del entorno (asi las inyecta docker-compose).

# --- Problema MCKP ---
N_OBRAS=326
PRESUPUESTO_PCT=0.35
K_MAX=50
MIN_POR_REGION=5

# --- Parametros del AG ---
POP_SIZE=150
N_GEN=400
PC=0.85
PM=0.015
K_TORNEO=3
ALPHA=2.5

# --- Analisis estadistico ---
N_RUNS=10
SEED=42

# --- Pesos de la funcion objetivo (deben sumar 1.0) ---
# W1=R (riesgo), W2=M (monto viable), W3=P (PIM), W4=E (ejecucion), W5=G (cobertura)
W1=0.40
W2=0.25
W3=0.15
W4=0.10
W5=0.10

# --- API ---
# Puerto de esta API (Parte 2). La Parte 1 usa el 8000.
API_PORT=8001
# URL de la API de la Parte 1, opcional: si no responde, el dataset se genera
# con data/generator.py a partir de data/calibracion_parte1.json.
PARTE1_API_URL=http://localhost:8000
