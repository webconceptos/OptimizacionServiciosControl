# Documentacion interna y entregables (no se publican)
docs/
*.docx
*.pptx

# Entorno virtual
.venv/
venv/
env/

# Caches de Python y herramientas
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
